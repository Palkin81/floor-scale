# Образец. Скопируйте в secrets.yaml в каталоге конфигурации ESPHome (рядом с floor-c6.yaml и floor-esp32.yaml)
# и впишите свои значения. Сам secrets.yaml в Git не добавляется.
espectre_encryption_key: "ВСТАВЬТЕ_BASE64_ОТ_32_БАЙТ"   # например: openssl rand -base64 32
prov_ssid: "scale_setup_net"                            # имя сети настройки (должно быть одинаковым на обоих устройствах)
prov_password: "ПАРОЛЬ_СЕТИ_НАСТРОЙКИ"                   # 8 и более символов
